module(
    name = "cracha",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_img", version = "0.3.23")

# The Helm chart (//charts/cracha): helm_chart packages it with the images'
# digests pinned, and the lint and template tests run the pinned helm. 0.34.0
# is the newest release in the Bazel Central Registry. It depends on rules_go
# 0.63.0 and gazelle 0.53.0, both below the versions above, so it adds no Go
# SDK: the root module's go_sdk.download below is the only one.
bazel_dep(name = "rules_helm", version = "0.34.0")

# Helm's own binary, so the chart is packaged, linted and installed with a
# pinned toolchain rather than whatever is on a developer's PATH: @helm//:helm
# is what e2e/run.sh runs. The version is pinned here for the host tool and in
# .bazelrc (--@rules_helm//helm/settings:version) for the rules' toolchain;
# keep the two the same.
helm = use_extension("@rules_helm//helm:extensions.bzl", "helm")
helm.host_tools(version = "4.2.0")
use_repo(helm, "helm", "helm_toolchains")

register_toolchains("@helm_toolchains//:all")

# Named by //bazel/image for string_flag, and already in the graph through
# rules_img and rules_go; declared so a bump of those cannot drop it.
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# sh_library and sh_test for the scripts under //bazel.
bazel_dep(name = "rules_shell", version = "0.8.0")

# Formatting and the linters that are not part of compiling: //bazel/format
# formats and checks Starlark (buildifier, with its lint warnings), Go and
# shell; //bazel/lint has the shellcheck aspect.
bazel_dep(name = "aspect_rules_lint", version = "2.9.1")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")

# The Go toolchain, pinned here rather than read from go.mod: go.mod's `go`
# line is the language version the module requires, this is the exact SDK
# every build compiles with. Bump both together; the SDK must not be older
# than the `go` line.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.2")

# Static analysis, run as part of compiling every Go package of this module
# (and of none of its dependencies): a finding fails the build. //:nogo says
# which analyzers.
go_sdk.nogo(nogo = "//:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "co_honnef_go_tools", "com_github_aws_aws_sdk_go_v2", "com_github_aws_aws_sdk_go_v2_config", "com_github_aws_aws_sdk_go_v2_credentials", "com_github_aws_aws_sdk_go_v2_service_accessanalyzer", "com_github_aws_aws_sdk_go_v2_service_kms", "com_github_aws_aws_sdk_go_v2_service_s3", "com_github_aws_aws_sdk_go_v2_service_sts", "com_github_container_storage_interface_spec", "com_github_go_logr_logr", "com_github_google_go_cmp", "com_github_spiffe_go_spiffe_v2", "com_github_uudashr_gocognit", "in_gopkg_evanphx_json_patch_v4", "in_gopkg_yaml_v3", "io_k8s_api", "io_k8s_apimachinery", "io_k8s_client_go", "io_k8s_klog_v2", "io_k8s_sigs_yaml", "org_golang_google_grpc", "org_golang_google_protobuf", "org_golang_x_sync")

# Container image base: distroless static on Debian 13, nonroot variant (user
# 65532), pinned by index digest so a moving tag cannot change the image.
# Resolved from gcr.io/distroless/static-debian13:nonroot. Layers are fetched
# lazily, only when an image is loaded, so `bazel build //...` needs no
# registry access and no Docker daemon.
pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

pull(
    name = "distroless_static",
    digest = "sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3",
    layer_handling = "lazy",
    registry = "gcr.io",
    repository = "distroless/static-debian13",
)
