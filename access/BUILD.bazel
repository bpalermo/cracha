load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//bazel:registry.bzl", "IMAGE_REGISTRY", "image_repository")
load("//bazel/image:defs.bzl", "go_image")

go_library(
    name = "access_lib",
    srcs = [
        "cli.go",
        "config.go",
        "main.go",
        "serve.go",
    ],
    importpath = "github.com/bpalermo/cracha/access",
    visibility = ["//visibility:private"],
    deps = [
        "//access/internal/api",
        "//access/internal/audit",
        "//access/internal/check",
        "//access/internal/service",
        "//access/internal/store",
        "//common/grant",
        "//common/idenc",
        "//common/publication",
        "//common/spicedb/conn",
        "//common/version",
        "@com_github_authzed_authzed_go//v1:authzed-go",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_config//:config",
        "@com_github_aws_aws_sdk_go_v2_service_accessanalyzer//:accessanalyzer",
        "@com_github_aws_aws_sdk_go_v2_service_kms//:kms",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
        "@com_github_spiffe_go_spiffe_v2//bundle/x509bundle",
        "@com_github_spiffe_go_spiffe_v2//spiffeid",
        "@com_github_spiffe_go_spiffe_v2//svid/x509svid",
        "@com_github_spiffe_go_spiffe_v2//workloadapi",
    ],
)

go_binary(
    name = "access",
    basename = "cracha-access",
    embed = [":access_lib"],
    # Pure Go: the image binary is cross-built for linux with cgo off.
    pure = "on",
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    base = "@distroless_static",
    binary = ":access",
    load_tag = "localhost/cracha-access:e2e",
    path = "/cracha-access",
    registry = IMAGE_REGISTRY,
    repository = image_repository("access"),
)

go_test(
    name = "access_test",
    srcs = ["main_test.go"],
    embed = [":access_lib"],
    deps = [
        "//access/internal/api",
        "@com_github_spiffe_go_spiffe_v2//spiffeid",
    ],
)
