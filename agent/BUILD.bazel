load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel:registry.bzl", "IMAGE_REGISTRY", "image_repository")
load("//bazel/image:defs.bzl", "go_image")

go_library(
    name = "agent_lib",
    srcs = [
        "config.go",
        "main.go",
    ],
    importpath = "github.com/bpalermo/cracha/agent",
    visibility = ["//visibility:private"],
    deps = [
        "//agent/enrolapi",
        "//agent/internal/broker",
        "//agent/internal/cni/install",
        "//agent/internal/cni/server",
        "//agent/internal/credentials",
        "//agent/internal/cri",
        "//agent/internal/enrol",
        "//agent/internal/identity",
        "//agent/internal/issuer",
        "//agent/internal/issuer/spire",
        "//agent/internal/listener",
        "//agent/internal/netns",
        "//agent/internal/recovery",
        "//agent/internal/serve",
        "//agent/internal/tokenreview",
        "//common/version",
        "@com_github_go_logr_logr//:logr",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//rest",
        "@io_k8s_klog_v2//:klog",
        "@org_golang_x_sync//errgroup",
    ],
)

go_binary(
    name = "agent",
    basename = "cracha-agent",
    embed = [":agent_lib"],
    # Pure Go: the image binary is cross-built for linux with cgo off.
    pure = "on",
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    base = "@distroless_static",
    binary = ":agent",
    # The cracha-cni plugin rides in the agent image, at the path
    # `cracha-agent cni-install` copies it from (DefaultPlugin of
    # agent/internal/cni/install).
    files = {"/opt/cracha/cni/cracha-cni": "//agent/cni"},
    load_tag = "localhost/cracha-agent:e2e",
    path = "/cracha-agent",
    registry = IMAGE_REGISTRY,
    repository = image_repository("agent"),
    # Root: setns into a pod's network namespace needs CAP_SYS_ADMIN, which
    # the runtime grants the container's process only as uid 0.
    user = "0",
)
