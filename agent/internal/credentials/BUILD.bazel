load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "credentials",
    srcs = ["handler.go"],
    importpath = "github.com/bpalermo/cracha/agent/internal/credentials",
    visibility = ["//agent:__subpackages__"],
    deps = [
        "//agent/internal/issuer",
        "//agent/internal/listener",
        "@com_github_spiffe_go_spiffe_v2//spiffeid",
        "@org_golang_x_sync//singleflight",
    ],
)

go_test(
    name = "credentials_test",
    srcs = ["handler_test.go"],
    embed = [":credentials"],
    deps = [
        "//agent/internal/issuer",
        "//agent/internal/jwttest",
        "//agent/internal/listener",
    ],
)
