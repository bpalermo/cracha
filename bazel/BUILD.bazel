load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The publishing coordinates (registry.bzl), the git state that stamps the
# images' tags, the binaries' version and the chart's version
# (workspace_status.sh), and the reader of a packaged chart's image pins
# (chart-pin.sh, run by //charts/cracha:pin_test).
exports_files([
    "chart-pin.sh",
    "registry.bzl",
    "workspace_status.sh",
])

# For the shellcheck aspect (--config=lint): the workspace status script is
# run by Bazel itself and chart-pin.sh is test data, so no target would
# otherwise show them to the aspect.
sh_library(
    name = "scripts",
    srcs = glob(["*.sh"]),
)

sh_test(
    name = "workspace_status_test",
    size = "small",
    srcs = ["workspace_status_test.sh"],
    data = ["workspace_status.sh"],
)
