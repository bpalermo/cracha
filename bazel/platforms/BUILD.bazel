# The platforms the Go binaries are built for. The image index switches only
# the target platform; the Go binaries are pure Go and cross-compile for any
# of these on any host. linux_amd64 and linux_arm64 are the image platforms;
# darwin_arm64 is only for the grantc release binaries (//grantc:BUILD.bazel).
package(default_visibility = ["//visibility:public"])

platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
)
