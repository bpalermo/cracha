load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "healthprobe_lib",
    srcs = ["main.go"],
    importpath = "github.com/bpalermo/cracha/bazel/spicedb/healthprobe",
    visibility = ["//visibility:private"],
    deps = [
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//health/grpc_health_v1",
    ],
)

# Pure Go, so it runs on the image's distroless static base.
go_binary(
    name = "grpc_health_probe",
    embed = [":healthprobe_lib"],
    pure = "on",
    visibility = ["//bazel/spicedb:__pkg__"],
)
