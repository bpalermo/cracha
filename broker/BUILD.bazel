load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel:registry.bzl", "IMAGE_REGISTRY", "image_repository")
load("//bazel/image:defs.bzl", "go_image")

go_library(
    name = "broker_lib",
    srcs = ["main.go"],
    importpath = "github.com/bpalermo/cracha/broker",
    visibility = ["//visibility:private"],
    deps = ["//common/version"],
)

go_binary(
    name = "broker",
    basename = "cracha-broker",
    embed = [":broker_lib"],
    # Pure Go: the image binary is cross-built for linux with cgo off.
    pure = "on",
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    base = "@distroless_static",
    binary = ":broker",
    load_tag = "localhost/cracha-2e",
    path = "/cracha-broker",
    registry = IMAGE_REGISTRY,
    repository = image_repository("broker"),
)
