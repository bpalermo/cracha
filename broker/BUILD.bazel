load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("//bazel:registry.bzl", "IMAGE_REGISTRY", "image_repository")
load("//bazel/image:defs.bzl", "go_image")

go_library(
    name = "broker_lib",
    srcs = [
        "authz.go",
        "config.go",
        "grants.go",
        "main.go",
        "spiffe.go",
    ],
    importpath = "github.com/bpalermo/cracha/broker",
    visibility = ["//visibility:private"],
    deps = [
        "//broker/internal/api",
        "//broker/internal/authn",
        "//broker/internal/authz",
        "//broker/internal/authz/spicedb",
        "//broker/internal/authz/static",
        "//broker/internal/bundle",
        "//broker/internal/cache",
        "//broker/internal/grants",
        "//broker/internal/health",
        "//broker/internal/issuer",
        "//broker/internal/mtls",
        "//broker/internal/sts",
        "//common/grant",
        "//common/idenc",
        "//common/spicedb/conn",
        "//common/version",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_config//:config",
        "@com_github_aws_aws_sdk_go_v2_service_kms//:kms",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
        "@com_github_spiffe_go_spiffe_v2//bundle/x509bundle",
        "@com_github_spiffe_go_spiffe_v2//spiffeid",
        "@com_github_spiffe_go_spiffe_v2//svid/x509svid",
        "@com_github_spiffe_go_spiffe_v2//workloadapi",
    ],
)

go_binary(
    name = "broker",
    basename = "cracha-broker",
    embed = [":broker_lib"],
    # Pure Go: the image binary is cross-built for linux with cgo off.
    pure = "on",
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    base = "@distroless_static",
    binary = ":broker",
    load_tag = "localhost/cracha-broker:e2e",
    path = "/cracha-broker",
    registry = IMAGE_REGISTRY,
    repository = image_repository("broker"),
)

go_test(
    name = "broker_test",
    srcs = [
        "authz_test.go",
        "config_test.go",
    ],
    embed = [":broker_lib"],
    deps = [
        "//broker/internal/authz",
        "//common/grant",
        "//common/spiffetest",
        "@com_github_spiffe_go_spiffe_v2//bundle/x509bundle",
        "@com_github_spiffe_go_spiffe_v2//spiffeid",
        "@com_github_spiffe_go_spiffe_v2//svid/x509svid",
    ],
)
