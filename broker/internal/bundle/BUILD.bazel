load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "bundle",
    srcs = [
        "bundle.go",
        "fetch.go",
    ],
    importpath = "github.com/bpalermo/cracha/broker/internal/bundle",
    visibility = ["//broker:__subpackages__"],
    deps = [
        "//broker/internal/grants",
        "//common/grant",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
    ],
)

go_test(
    name = "bundle_test",
    srcs = [
        "bundle_test.go",
        "fetch_test.go",
    ],
    embed = [":bundle"],
    deps = [
        "//common/grant",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
    ],
)
