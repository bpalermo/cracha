load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "sts",
    srcs = ["sts.go"],
    importpath = "github.com/bpalermo/cracha/broker/internal/sts",
    visibility = ["//broker:__subpackages__"],
    deps = [
        "@com_github_aws_aws_sdk_go_v2//aws",
