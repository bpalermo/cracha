load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel:registry.bzl", "IMAGE_REGISTRY", "image_repository")
load("//bazel/image:defs.bzl", "go_image")

go_library(
    name = "csi_lib",
    srcs = ["main.go"],
    importpath = "github.com/bpalermo/cracha/csi",
    visibility = ["//visibility:private"],
    deps = [
        "//common/version",
        "//csi/internal/driver",
        "//csi/internal/issuer",
        "//csi/internal/issuer/spire",
        "//csi/internal/token",
        "//csi/internal/tokenreview",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//rest",
        "@org_golang_x_sync//errgroup",
    ],
)

go_binary(
    name = "csi",
    basename = "cracha-csi",
    embed = [":csi_lib"],
    # Pure Go: the image binary is cross-built for linux with cgo off.
    pure = "on",
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    base = "@distroless_static",
    binary = ":csi",
    load_tag = "localhost/cracha-csi:e2e",
    path = "/cracha-csi",
    registry = IMAGE_REGISTRY,
    repository = image_repository("csi"),
    # Writes into kubelet pod directories from a DaemonSet.
    user = "0",
)
