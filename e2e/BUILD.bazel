load("@rules_go//go:def.bzl", "go_test")
load("@rules_shell//shell:sh_library.bzl", "sh_library")

go_test(
    name = "e2e_test",
    srcs = [
        "credentials_test.go",
        "enrol_test.go",
        "main_test.go",
        "prewarm_test.go",
        "published_test.go",
        "resources_test.go",
        "spicedb_test.go",
        "webhook_test.go",
    ],
    # What e2e/run.sh deploys beside the chart and runs: the manifests, the
    # values files, the grant sources it compiles into the bundle and, in
    # spicedb mode, reconciles into SpiceDB, spire.sh, run.sh itself, the
    # kind node image it creates the cluster from, the grant compiler and
    # the reconciler. They are its data so that a change to any of them
    # impacts the test in the Bazel graph, which is how CI decides whether
    # to run the kind job (bazel/ci-impacted-targets.sh). The test copies
    # the grant sources, runs grantc on the copy (published_test.go) and
    # the reconciler (spicedb_test.go); the rest it never opens.
    data = glob([
        "grants/**",
        "manifests/*",
        "*.sh",
        "*.yaml",
    ]) + [
        "kind-node-image",
        "//grantc",
        "//reconciler",
    ],
    # Needs a cluster: excluded from `bazel test //...` by the e2e tag (see
    # .bazelrc) and run unsandboxed by e2e/run.sh, so it can read the
    # kubeconfig KUBECONFIG names.
    tags = [
        "e2e",
        "local",
    ],
    deps = [
        "//common/grant",
        "@io_k8s_api//apps/v1:apps",
        "@io_k8s_api//core/v1:core",
        "@io_k8s_apimachinery//pkg/api/errors",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/types",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//tools/clientcmd",
        "@rules_go//go/runfiles",
    ],
)

# For the shellcheck aspect (--config=lint); nothing depends on it.
sh_library(
    name = "scripts",
    srcs = glob(["*.sh"]),
)
