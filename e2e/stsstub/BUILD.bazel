load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/image:defs.bzl", "go_image")

go_library(
    name = "stsstub_lib",
    srcs = ["main.go"],
    importpath = "github.com/bpalermo/cracha/e2e/stsstub",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "stsstub",
    basename = "stsstub",
    embed = [":stsstub_lib"],
    # Pure Go: the image binary is cross-built for linux with cgo off.
    pure = "on",
    visibility = ["//visibility:public"],
)

# The STS stand-in the end-to-end suite points the broker at. Loaded into the
# kind node by e2e/run.sh; never published, hence no registry.
go_image(
    name = "image",
    base = "@distroless_static",
    binary = ":stsstub",
    load_tag = "localhost/cracha-e2e-stsstub:e2e",
    path = "/stsstub",
)
