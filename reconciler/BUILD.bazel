load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "reconciler_lib",
    srcs = ["main.go"],
    importpath = "github.com/bpalermo/cracha/reconciler",
    visibility = ["//visibility:private"],
    deps = [
        "//common/spicedb",
        "//common/spicedb/conn",
        "//common/version",
        "@com_github_authzed_authzed_go//proto/authzed/api/v1:api",
        "@com_github_spiffe_go_spiffe_v2//bundle/x509bundle",
        "@com_github_spiffe_go_spiffe_v2//spiffeid",
        "@com_github_spiffe_go_spiffe_v2//svid/x509svid",
        "@com_github_spiffe_go_spiffe_v2//workloadapi",
    ],
)

go_binary(
    name = "reconciler",
    basename = "cracha-reconciler",
    embed = [":reconciler_lib"],
    # Pure Go, like the other binaries; the reconciler runs from CI or an
    # operator's machine, not in an image.
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "reconciler_test",
    srcs = ["main_test.go"],
    embed = [":reconciler_lib"],
    deps = [
        "//common/spicedb",
        "//common/spiffetest",
        "@com_github_authzed_authzed_go//proto/authzed/api/v1:api",
        "@com_github_spiffe_go_spiffe_v2//spiffetls/tlsconfig",
        "@com_github_spiffe_go_spiffe_v2//svid/x509svid",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//peer",
    ],
)
