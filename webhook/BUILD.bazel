load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel:registry.bzl", "IMAGE_REGISTRY", "image_repository")
load("//bazel/image:defs.bzl", "go_image")

go_library(
    name = "webhook_lib",
    srcs = ["main.go"],
    importpath = "github.com/bpalermo/cracha/webhook",
    visibility = ["//visibility:private"],
    deps = [
        "//common/version",
        "//webhook/internal/mutate",
        "//webhook/internal/sacache",
        "//webhook/internal/server",
        "@com_github_go_logr_logr//:logr",
        "@io_k8s_client_go//kubernetes",
        "@io_k8s_client_go//rest",
        "@io_k8s_client_go//tools/clientcmd",
        "@io_k8s_klog_v2//:klog",
    ],
)

go_binary(
    name = "webhook",
    basename = "cracha-webhook",
    embed = [":webhook_lib"],
    # Pure Go: the image binary is cross-built for linux with cgo off.
    pure = "on",
    visibility = ["//visibility:public"],
)

go_image(
    name = "image",
    base = "@distroless_static",
    binary = ":webhook",
    load_tag = "localhost/cracha-2e",
    path = "/cracha-webhook",
    registry = IMAGE_REGISTRY,
    repository = image_repository("webhook"),
)
