{
  "kind": "Pod",
  "apiVersion": "v1",
  "metadata": {
    "generateName": "web-",
    "namespace": "apps",
    "labels": {
      "app": "web",
      "cracha.dev/credentials": "true"
    },
    "annotations": {
      "team": "payments"
    }
  },
  "spec": {
    "volumes": [
      {
        "name": "data",
        "emptyDir": {}
      }
    ],
    "initContainers": [
      {
        "name": "migrate",
        "image": "example/migrate",
        "env": [
          {
            "name": "DATABASE_URL",
            "value": "postgres://ledger"
          },
          {
            "name": "AWS_CONTAINER_CREDENTIALS_FULL_URI",
            "value": "http://127.0.0.1:8780/v1/credentials"
          },
          {
            "name": "AWS_REGION",
            "value": "eu-west-1"
          }
        ],
        "resources": {}
      }
    ],
    "containers": [
      {
        "name": "app",
        "image": "example/app",
        "env": [
          {
            "name": "FOO",
            "value": "bar"
          },
          {
            "name": "AWS_REGION",
            "value": "us-east-1"
          },
          {
            "name": "AWS_CONTAINER_CREDENTIALS_FULL_URI",
            "value": "http://127.0.0.1:8780/v1/credentials"
          }
        ],
        "resources": {},
        "volumeMounts": [
          {
            "name": "data",
            "mountPath": "/data"
          }
        ]
      },
      {
        "name": "sidecar",
        "image": "example/sidecar",
        "env": [
          {
            "name": "AWS_CONTAINER_CREDENTIALS_FULL_URI",
            "value": "http://127.0.0.1:8780/v1/credentials"
          },
          {
            "name": "AWS_REGION",
            "value": "eu-west-1"
          }
        ],
        "resources": {}
      }
    ],
    "serviceAccountName": "enabled",
    "securityContext": {
      "runAsUser": 1000,
      "fsGroup": 1000
    }
  },
  "status": {}
}
