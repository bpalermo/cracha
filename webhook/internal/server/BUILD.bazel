load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "server",
    srcs = ["server.go"],
    importpath = "github.com/bpalermo/cracha/webhook/internal/server",
    visibility = ["//webhook:__subpackages__"],
    deps = ["@io_k8s_api//admission/v1:admission"],
)

go_test(
    name = "server_test",
    srcs = ["server_test.go"],
    embed = [":server"],
    deps = [
        "@io_k8s_api//admission/v1:admission",
        "@io_k8s_apimachinery//pkg/apis/meta/v1:meta",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/types",
    ],
)
